MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=ai_cognitive_mind
APP_NAME=AI Cognitive Mind
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
ADMIN_PIN=
STORAGE_PROVIDER=surreal
SURREALDB_URI=surrealkv://.surreal/cognitive_mind
SURREALDB_NAMESPACE=mir_ai
SURREALDB_DATABASE=ai_cognitive_mind
SURREALDB_USERNAME=
SURREALDB_PASSWORD=
SURREALDB_AUTH_LEVEL=database
APP_ACCESS_USERNAME=mind
APP_ACCESS_PASSWORD=

# Optional standalone inference; external MCP hosts remain primary.
STANDALONE_REASONING_PROVIDER=disabled
STANDALONE_CALLS_PER_MINUTE=6
STANDALONE_QUOTA_COOLDOWN_SECONDS=300
REASONING_TIMEOUT_SECONDS=120
# Required when exposing the separate MCP HTTP server beyond loopback.
MCP_ACCESS_TOKEN=

# Optional public origin override for the co-hosted ChatGPT MCP OAuth endpoint.
# Render normally supplies RENDER_EXTERNAL_URL automatically.
AXIOM_PUBLIC_URL=
