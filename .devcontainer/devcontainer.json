{
  "name": "AICognitiveMind",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/AICognitiveMind",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Cognitive Mind API",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e '.[dev]'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "mongodb.mongodb-vscode"
      ]
    }
  }
}

